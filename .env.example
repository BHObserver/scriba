# Scriba environment template. Copy to .env.local and fill in real values.
# Never commit .env.local. This file must only ever contain placeholders.

# --- Supabase (the dedicated Scriba project only) ---------------------------
# Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only. Used solely to write extraction results, usage records,
# confirmations and evaluation summaries after the server has verified the
# signed-in user. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Meta Model API ------------------------------------------------------------
# https://dev.meta.ai/platform. Server-only.
META_MODEL_API_KEY=
# Standard mode: submitted content is not used for training.
# Do not switch to a "-contributor" model ID without a deliberate decision.
# muse-wonder-1.0 read handwritten Bangla digits far more reliably than
# muse-spark-1.3 (docs/HANDOFF.md, 30 Oct). Spark is ~4x cheaper per image.
META_MODEL_ID=muse-wonder-1.0
META_MODEL_BASE_URL=https://api.meta.ai/v1
# Reasoning tokens count against the output budget (dev.meta.ai/docs/reasoning).
META_REASONING_EFFORT=low
# Abort the single paid request after this many milliseconds. It is never retried automatically.
META_REQUEST_TIMEOUT_MS=240000

# --- Scriba limits -----------------------------------------------------------
SCRIBA_MAX_UPLOAD_BYTES=8388608
# Ceiling for reasoning + JSON together; only tokens actually used are billed.
# First live run: an 8-line snippet used 2,308 (1,254 of them reasoning), so 1,800 was too low.
SCRIBA_MAX_OUTPUT_TOKENS=8000
# Paid extraction requests allowed per user (rolling windows).
SCRIBA_EXTRACTIONS_PER_HOUR=30
SCRIBA_EXTRACTIONS_PER_DAY=150
# Comma-separated emails allowed to start paid extractions. Empty = any signed-in user.
# Strongly recommended for a public deployment.
SCRIBA_EXTRACTION_ALLOWED_EMAILS=
